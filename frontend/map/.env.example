# true  = use built-in sample tickets (work without backend)
# false = call Vinit's backend at GET /requests
VITE_USE_MOCK=true

# How often the map re-fetches tickets (milliseconds)
VITE_REFRESH_MS=5000

# Backend address used by the dev proxy (vite.config.js)
VITE_BACKEND_URL=http://localhost:8000
